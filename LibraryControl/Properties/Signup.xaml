<Window x:Class="LibraryControl.Properties.Signup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryControl.Properties"
        mc:Ignorable="d"
        Title="Signup" Height="450" Width="800" Background="Wheat">
    <Grid>
        <Border Background="White" Margin="185,10,185,0">
            <StackPanel Margin="0,0,0,-3">
                <Label Content=" Sign Up " FontSize="30" HorizontalAlignment="Center"
                       FontWeight="Bold" Width="160"/>
                <Label Content="Full Name" FontSize="17" Width="351"   />
                <TextBox x:Name="txtFullName" Height="27" Width="354"></TextBox>
                <Label Content="Password" FontSize="17" Width="351"   />
                <TextBox x:Name="txtPassword" Height="27" Width="354"></TextBox>
                <Label Content="Confirm" FontSize="17" Width="351"   />
                <TextBox x:Name="txtConfirm" Height="27" Width="354"></TextBox>
                <Label Content="Email" FontSize="17" Width="351"   />
                <TextBox x:Name="txtEmail" Height="27" Width="354"></TextBox>
                <Grid>
                    <Label Content="Role" FontSize="17" Width="351"   />
                    <RadioButton Margin="103,10,-103,-10">Librarian</RadioButton>
                    <RadioButton Margin="182,11,-182,-11">Member</RadioButton>

                </Grid>

                <Button Content="Sign Up" Foreground="Blue" FontSize="17" Width="139" Click="SignUp"></Button>
                <TextBlock HorizontalAlignment="Center">
                    "Do you have account ?"
                    <Hyperlink Click="Login"  >
                          Login                  
                    </Hyperlink></TextBlock>
            </StackPanel>

        </Border>
    </Grid>
</Window>
